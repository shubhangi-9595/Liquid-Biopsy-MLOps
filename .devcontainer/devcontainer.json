{
  // Open the repo in GitHub Codespaces (Code -> Codespaces -> Create) and everything
  // below is preinstalled: Python 3.12, Docker, kubectl + helm, kind, Azure CLI + Bicep,
  // GitHub CLI and the project's dependencies. No local setup or GPU needed.
  "name": "liquid-biopsy-mlops",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "minikube": "none" },
    "ghcr.io/devcontainers/features/azure-cli:1": { "installBicep": true, "extensions": "containerapp,ml" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8000, 5000],
  "portsAttributes": {
    "8000": { "label": "API (/docs)" },
    "5000": { "label": "MLflow UI" }
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-bicep",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
